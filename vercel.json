{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(wp-admin|wp-login\\.php|xmlrpc\\.php|\\.env|\\.git|phpmyadmin)(/.*)?",
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "/security/challenge",
      "mitigate": {
        "action": "challenge"
      }
    }
  ]
}

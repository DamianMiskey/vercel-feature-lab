# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (mark DEMO_SECRET as Sensitive).
APP_NAME=Vercel Feature Lab
NEXT_PUBLIC_APP_NAME=Vercel Feature Lab
DEMO_SECRET=local-only-secret-value
# Protects the revalidation webhook (POST /api/static/revalidate). Sensitive on Vercel.
REVALIDATE_SECRET=local-only-revalidate-secret
# Signs the session cookie for the Proxy auth-gate demo. Sensitive on Vercel.
SESSION_SECRET=local-only-session-secret
# Global Config (formerly Edge Config) connection string for the feature-lab
# store: https://global-config.vercel.com/<id>?token=<read token>. Sensitive on Vercel.
GLOBAL_CONFIG=
# Flags SDK key: 32 random bytes, base64url. A different value per environment.
FLAGS_SECRET=
